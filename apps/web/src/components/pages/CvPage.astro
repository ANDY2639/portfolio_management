---
import Layout from '../../layouts/Layout.astro';
import { getSiteContent } from '@portfolio/data';
import { formatDate, getLocalizedPath, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const content = await getSiteContent(lang);
const p = content.profile;
const remoteLabel = lang === 'es' ? 'Remoto' : 'Remote';
---

<Layout
  title={`${t('cv.title')} — ${p?.fullName ?? 'Andrés Guerrero'}`}
  description={t('meta.description')}
  lang={lang}
  page="cv"
>
  <section class="section cv-page">
    <div class="container cv">
      <div class="cv-actions no-print">
        {p?.cvUrl ? (
          <a class="btn-term btn-primary" href={p.cvUrl} download>{t('cv.download')}</a>
        ) : (
          <button id="cv-print" class="btn-term btn-primary" type="button">{t('cv.download')}</button>
        )}
        <a class="btn-term btn-ghost" href={getLocalizedPath(lang, '/')}>cd ~</a>
      </div>

      <header class="cv-header">
        <p class="section-tag">cv.ts</p>
        <h1 class="cv-name">{p?.fullName}</h1>
        <p class="cv-role">{p?.title}</p>
        <p class="cv-contact">
          <span>{p?.location}</span>
          <a href={`mailto:${p?.email ?? ''}`}>{p?.email}</a>
          <a href={p?.github ?? '#'} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={p?.linkedin ?? '#'} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </p>
      </header>

      <section class="cv-section">
        <h2>{t('cv.summary')}</h2>
        <p>{p?.bioP1}</p>
        <p>{p?.bioP2}</p>
      </section>

      <section class="cv-section">
        <h2>{t('cv.experience')}</h2>
        {content.experience.map((item) => (
          <article class="cv-item">
            <div class="cv-item-head">
              <h3>{item.role} · {item.company}</h3>
              <span>
                {formatDate(item.startDate, lang)} — {item.isCurrent ? t('experience.present') : formatDate(item.endDate, lang)}
              </span>
            </div>
            <p class="cv-meta">
              {item.location}{item.isRemote ? ` · ${remoteLabel}` : ''}
            </p>
            <p>{item.summary}</p>
            {item.achievements.length > 0 && (
              <ul>
                {item.achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </section>

      <section class="cv-section">
        <h2>{t('cv.education')}</h2>
        {content.education.map((item) => (
          <article class="cv-item">
            <div class="cv-item-head">
              <h3>{item.degree} · {item.institution}</h3>
              <span>
                {formatDate(item.startDate, lang)} — {item.isCurrent ? t('education.present') : formatDate(item.endDate, lang)}
              </span>
            </div>
            {item.field && <p class="cv-meta">{item.field}</p>}
          </article>
        ))}
      </section>

      <section class="cv-section">
        <h2>{t('cv.skills')}</h2>
        {content.skillGroups.map((group) => (
          <p class="cv-skills">
            <strong>{group.label}:</strong> {group.skills.map((skill) => skill.name).join(', ')}
          </p>
        ))}
      </section>

      <section class="cv-section">
        <h2>{t('cv.certifications')}</h2>
        <ul class="cv-certs">
          {content.certifications.map((cert) => (
            <li>{cert.name} — {cert.issuer}, {formatDate(cert.issuedDate, lang)}</li>
          ))}
        </ul>
      </section>

      <p class="cv-note no-print">{t('cv.note')}</p>
    </div>
  </section>
</Layout>

<script>
  document.getElementById('cv-print')?.addEventListener('click', () => window.print());
</script>

<style>
  .cv {
    max-width: 820px;
  }

  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-bottom: var(--sp-10);
  }

  .btn-term {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--sp-2) var(--sp-5);
    border: 1px solid;
    transition: all var(--dur-fast);
    white-space: nowrap;
    letter-spacing: 0.02em;
    cursor: pointer;
  }

  .btn-primary {
    border-color: var(--green);
    color: var(--green);
    background: var(--green-bg);
  }
  .btn-primary:hover {
    background: var(--green);
    color: var(--bg);
  }

  .btn-ghost {
    border-color: var(--border-hi);
    color: var(--fg-2);
    background: transparent;
  }
  .btn-ghost:hover {
    border-color: var(--fg-3);
    color: var(--fg);
  }

  .cv-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--sp-6);
  }

  .cv-name {
    font-size: var(--text-4xl);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-top: var(--sp-3);
  }

  .cv-role {
    color: var(--green);
    font-size: var(--text-lg);
    margin-top: var(--sp-2);
  }

  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    margin-top: var(--sp-4);
    font-size: var(--text-sm);
    color: var(--fg-3);
  }

  .cv-contact a {
    color: var(--fg-2);
    border-bottom: 1px solid var(--border);
  }

  .cv-section {
    margin-top: var(--sp-10);
  }

  .cv-section h2 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--green);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--sp-2);
    margin-bottom: var(--sp-5);
  }

  .cv-section p,
  .cv-section li {
    font-size: var(--text-sm);
    color: var(--fg-2);
    line-height: 1.7;
  }

  .cv-item {
    margin-bottom: var(--sp-5);
  }

  .cv-item-head {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    align-items: baseline;
  }

  .cv-item-head h3 {
    font-size: var(--text-base);
    color: var(--fg);
  }

  .cv-item-head span {
    font-size: var(--text-xs);
    color: var(--fg-3);
    white-space: nowrap;
  }

  .cv-meta {
    color: var(--fg-3) !important;
    font-size: var(--text-xs) !important;
    margin: var(--sp-1) 0 var(--sp-2);
  }

  .cv-item ul {
    margin-top: var(--sp-2);
    padding-left: var(--sp-5);
  }

  .cv-item li {
    margin-bottom: var(--sp-1);
  }

  .cv-skills {
    margin-bottom: var(--sp-2);
  }

  .cv-skills strong {
    color: var(--fg);
    font-weight: 500;
  }

  .cv-certs {
    list-style: none;
    display: grid;
    gap: var(--sp-1);
  }

  .cv-note {
    margin-top: var(--sp-10);
    font-size: var(--text-xs);
    color: var(--fg-3);
    font-style: italic;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .cv-section {
      break-inside: avoid;
    }

    .cv-item {
      break-inside: avoid;
    }
  }
</style>
