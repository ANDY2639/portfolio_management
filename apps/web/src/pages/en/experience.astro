---
import Layout from '../../layouts/Layout.astro';
import ExperienceSection from '../../components/sections/ExperienceSection.astro';
import EducationSection from '../../components/sections/EducationSection.astro';
import { getExperience, getEducation } from '../../lib/portfolio-data';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const lang: Lang = 'en';
const t = useTranslations(lang);
const [experienceResult, educationResult] = await Promise.all([getExperience(), getEducation()]);
---
<Layout title={`experience() — Andrés Guerrero`} description={t('meta.experience.description')} lang={lang} page="experience">
  <section class="section page-hero" aria-labelledby="exp-page-title">
    <div class="container">
      <p class="section-tag">experience.ts</p>
      <h1 class="section-heading" id="exp-page-title">{t('experience.title')}</h1>
      <p class="section-lead">{t('experience.subtitle')}</p>
    </div>
  </section>
  <ExperienceSection experience={experienceResult.data} error={experienceResult.error} lang={lang} />
  <EducationSection education={educationResult.data} error={educationResult.error} lang={lang} />
</Layout>
<style>
  .page-hero { background: var(--bg-alt); border-bottom: 1px solid var(--border); padding-block: var(--sp-20) var(--sp-10); }
</style>
