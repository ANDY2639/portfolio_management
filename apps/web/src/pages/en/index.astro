---
import Layout from '../../layouts/Layout.astro';
import SkillsSection from '../../components/sections/SkillsSection.astro';
import CertificationsSection from '../../components/sections/CertificationsSection.astro';
import ProjectsSection from '../../components/sections/ProjectsSection.astro';
import ExperienceSection from '../../components/sections/ExperienceSection.astro';
import EducationSection from '../../components/sections/EducationSection.astro';
import { getSiteContent } from '@portfolio/data';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const lang: Lang = 'en';
const t = useTranslations(lang);

const content = await getSiteContent(lang);
const p = content.profile;
const { skillGroups, experience, education, certifications, projects } = content;

const certCountBySkill: Record<string, number> = {};
for (const cert of certifications) {
  for (const kw of cert.keywords) {
    const kwLower = kw.trim().toLowerCase();
    for (const group of skillGroups) {
      for (const skill of group.skills) {
        if (skill.name.trim().toLowerCase() === kwLower) {
          certCountBySkill[skill.name] = (certCountBySkill[skill.name] ?? 0) + 1;
        }
      }
    }
  }
}
---

<Layout title={`ag() — ${t('hero.title')}`} description={t('meta.description')} lang={lang} page="home">

  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-scanlines" aria-hidden="true"></div>
    <div class="container hero-body">
      <div class="hero-gutter" aria-hidden="true">
        {Array.from({length: 24}, (_, i) => <span class="ln">{String(i + 1).padStart(2, '0')}</span>)}
      </div>
      <div class="hero-content">
        <div class="hero-breadcrumb">
          <span class="crumb-dim">~/portfolio/</span><span class="crumb-green">{p?.terminalUser ?? 'andres_guerrero'}</span>
          <span class="cursor-blink" aria-hidden="true">█</span>
        </div>
        <p class="hero-comment">// {p?.title ?? t('hero.title')}</p>
        <h1 id="hero-title" class="hero-name">
          {p ? (
            <>
              <span class="name-fn">{p.displayName.split(' ')[0]}</span>
              <span class="name-ln">{p.displayName.split(' ')[1]}</span>
            </>
          ) : (
            <>
              <span class="name-fn">{t('hero.name').split(' ')[0]}</span>
              <span class="name-ln">{t('hero.name').split(' ')[1]}</span>
            </>
          )}
        </h1>
        <p class="hero-tagline">
          <span class="tag-prompt" aria-hidden="true">&gt; </span>
          <span class="typewriter" id="typewriter" aria-label={t('hero.subtitle')}></span>
          <span class="cursor-inline" aria-hidden="true">_</span>
        </p>
        <div class="hero-meta">
          <span class="meta-item"><span class="meta-key">status</span><span class="meta-sep">:</span><span class="meta-val meta-green">● {t('hero.available')}</span></span>
          <span class="meta-item"><span class="meta-key">loc</span><span class="meta-sep">:</span><span class="meta-val">"{p?.location ?? t('about.location')}"</span></span>
          <span class="meta-item"><span class="meta-key">exp</span><span class="meta-sep">:</span><span class="meta-val">"{t('about.experience')}"</span></span>
        </div>
        <div class="hero-cta">
          <a href="#experience" class="btn-term btn-primary"><span aria-hidden="true">$ </span>cd ./experience</a>
          <a href={`mailto:${p?.email ?? 'dev.andres.guerrero@gmail.com'}`} class="btn-term btn-ghost"><span aria-hidden="true">$ </span>mail --compose</a>
        </div>
      </div>
      <aside class="hero-terminal" aria-hidden="true">
        <div class="term-titlebar">
          <span class="term-dot dot-red"></span>
          <span class="term-dot dot-yellow"></span>
          <span class="term-dot dot-green"></span>
          <span class="term-title">ag — zsh</span>
        </div>
        <div class="term-body">
          <p><span class="t-prompt">ag@portfolio</span><span class="t-dim">:</span><span class="t-path">~</span><span class="t-dim">$</span> whoami</p>
          <p class="t-out">{p?.terminalUser ?? 'andres_guerrero'}</p>
          <p class="t-blank">&nbsp;</p>
          <p><span class="t-prompt">ag@portfolio</span><span class="t-dim">:</span><span class="t-path">~</span><span class="t-dim">$</span> cat skills.json | jq '.highlight'</p>
          <p class="t-out t-green">[</p>
          <p class="t-out t-green t-indent">"TypeScript",</p>
          <p class="t-out t-green t-indent">"React / Next.js",</p>
          <p class="t-out t-green t-indent">"Node.js",</p>
          <p class="t-out t-green t-indent">"Go",</p>
          <p class="t-out t-green t-indent">"PostgreSQL",</p>
          <p class="t-out t-green t-indent">"Supabase"</p>
          <p class="t-out t-green">]</p>
          <p class="t-blank">&nbsp;</p>
          <p><span class="t-prompt">ag@portfolio</span><span class="t-dim">:</span><span class="t-path">~</span><span class="t-dim">$</span> <span class="t-cursor">█</span></p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section about-section" id="about" aria-labelledby="about-title">
    <div class="container">
      <p class="section-tag">about.ts</p>
      <h2 class="section-heading" id="about-title">{t('about.title')}</h2>
      <div class="about-grid">
        <div class="about-text">
          <p class="about-p">{p?.bioP1 ?? t('about.p1')}</p>
          <p class="about-p">{p?.bioP2 ?? t('about.p2')}</p>
          <p class="about-p about-p-dim">{p?.bioP3 ?? t('about.p3')}</p>
        </div>
        <ul class="about-props">
          <li class="prop"><span class="prop-key">architecture</span><span class="prop-sep">:</span><span class="prop-val">{t('about.card.architecture.desc')}</span></li>
          <li class="prop"><span class="prop-key">quality</span><span class="prop-sep">:</span><span class="prop-val">{t('about.card.quality.desc')}</span></li>
          <li class="prop"><span class="prop-key">delivery</span><span class="prop-sep">:</span><span class="prop-val">{t('about.card.delivery.desc')}</span></li>
          <li class="prop"><span class="prop-key">remote</span><span class="prop-sep">:</span><span class="prop-val prop-green">{p?.availabilityOpen ? 'true' : 'false'}</span></li>
          <li class="prop"><span class="prop-key">location</span><span class="prop-sep">:</span><span class="prop-val prop-str">"{p?.location ?? t('about.location')}"</span></li>
        </ul>
      </div>
    </div>
  </section>

  <SkillsSection groups={skillGroups} lang={lang} certCountBySkill={certCountBySkill} />
  <ExperienceSection experience={experience} error={null} lang={lang} />
  <EducationSection education={education} error={null} lang={lang} />
  <CertificationsSection certifications={certifications} error={null} lang={lang} />
  {projects.length > 0 && <ProjectsSection projects={projects} error={null} lang={lang} />}

  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <p class="section-tag">contact.ts</p>
      <h2 class="section-heading" id="contact-title">{t('contact.title')}</h2>
      <p class="section-lead">{t('contact.subtitle')}</p>
      <div class="contact-block">
        <p class="contact-comment">// {t('contact.cta')}</p>
        <div class="contact-links">
          <a href={`mailto:${p?.email ?? 'dev.andres.guerrero@gmail.com'}`} class="contact-cmd">
            <span class="cmd-prompt">&gt;</span><span class="cmd-verb">mail</span><span class="cmd-arg">{p?.email ?? 'dev.andres.guerrero@gmail.com'}</span>
          </a>
          <a href={p?.linkedin ?? '#'} target="_blank" rel="noopener noreferrer" class="contact-cmd">
            <span class="cmd-prompt">&gt;</span><span class="cmd-verb">open</span><span class="cmd-arg">{(p?.linkedin ?? '').replace('https://', '')}</span>
          </a>
          <a href={p?.github ?? '#'} target="_blank" rel="noopener noreferrer" class="contact-cmd">
            <span class="cmd-prompt">&gt;</span><span class="cmd-verb">open</span><span class="cmd-arg">{(p?.github ?? '').replace('https://', '')}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; border-bottom: 1px solid var(--border); overflow: hidden; }
  .hero-scanlines { position: absolute; inset: 0; pointer-events: none; z-index: 1; background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,.04) 2px, rgba(0,0,0,.04) 4px); }
  .hero-body { position: relative; z-index: 2; display: grid; grid-template-columns: 48px 1fr 420px; gap: var(--sp-8); align-items: center; padding-block: var(--sp-24); }
  .hero-gutter { display: flex; flex-direction: column; align-self: stretch; padding-top: 2px; border-right: 1px solid var(--border); padding-right: var(--sp-3); }
  .ln { font-size: 11px; color: var(--fg-4); line-height: 1.75rem; display: block; text-align: right; font-family: var(--font-mono); user-select: none; }
  .hero-content { padding-left: var(--sp-8); display: flex; flex-direction: column; gap: var(--sp-6); }
  .hero-breadcrumb { font-size: var(--text-sm); display: flex; align-items: center; }
  .crumb-dim { color: var(--fg-3); } .crumb-green { color: var(--green); }
  .cursor-blink { color: var(--green); animation: blink 1.2s step-end infinite; margin-left: 2px; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
  .hero-comment { font-size: var(--text-sm); color: var(--fg-3); font-style: italic; }
  .hero-name { display: flex; flex-direction: column; font-size: clamp(var(--text-5xl), 6vw, var(--text-7xl)); font-weight: 700; letter-spacing: -.03em; line-height: 1; gap: 2px; }
  .name-fn { color: var(--fg); } .name-ln { color: var(--green); }
  .hero-tagline { font-size: var(--text-base); color: var(--fg-2); display: flex; align-items: baseline; min-height: 1.6em; }
  .tag-prompt { color: var(--green); margin-right: 4px; }
  .cursor-inline { color: var(--green); animation: blink 1s step-end infinite; margin-left: 1px; }
  .hero-meta { display: flex; flex-direction: column; gap: var(--sp-2); border-left: 2px solid var(--border); padding-left: var(--sp-4); }
  .meta-item { font-size: var(--text-sm); display: flex; align-items: center; gap: 4px; }
  .meta-key { color: var(--fg-2); } .meta-sep { color: var(--fg-3); } .meta-val { color: var(--fg-2); } .meta-green { color: var(--green); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .btn-term { font-family: var(--font-mono); font-size: var(--text-sm); padding: var(--sp-2) var(--sp-5); border: 1px solid; transition: all var(--dur-fast); white-space: nowrap; }
  .btn-primary { border-color: var(--green); color: var(--green); background: var(--green-bg); }
  .btn-primary:hover { background: var(--green); color: #0a0a0a; }
  .btn-ghost { border-color: var(--border-hi); color: var(--fg-2); background: transparent; }
  .btn-ghost:hover { border-color: var(--fg-3); color: var(--fg); }
  .hero-terminal { background: var(--surface); border: 1px solid var(--border-hi); font-size: var(--text-xs); line-height: 1.8; overflow: hidden; align-self: center; }
  .term-titlebar { display: flex; align-items: center; gap: var(--sp-2); padding: var(--sp-2) var(--sp-4); background: var(--surface-2); border-bottom: 1px solid var(--border); }
  .term-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .dot-red { background: #ff5f57; } .dot-yellow { background: #febc2e; } .dot-green { background: #28c840; }
  .term-title { flex: 1; text-align: center; color: var(--fg-3); font-size: var(--text-xs); }
  .term-body { padding: var(--sp-4) var(--sp-5); display: flex; flex-direction: column; }
  .term-body p { white-space: nowrap; overflow: hidden; }
  .t-prompt { color: var(--green); } .t-path { color: var(--green); opacity: .7; } .t-dim { color: var(--fg-3); }
  .t-out { color: var(--fg-2); padding-left: var(--sp-2); } .t-green { color: var(--green); } .t-indent { padding-left: var(--sp-6); }
  .t-blank { height: .8rem; } .t-cursor { color: var(--green); animation: blink 1.2s step-end infinite; }

  .about-section { background: var(--bg-alt); border-bottom: 1px solid var(--border); }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-16); margin-top: var(--sp-8); }
  .about-text { display: flex; flex-direction: column; gap: var(--sp-5); border-left: 2px solid var(--border); padding-left: var(--sp-6); }
  .about-p { font-size: var(--text-base); color: var(--fg-2); line-height: 1.85; } .about-p-dim { color: var(--fg-3); font-style: italic; }
  .about-props { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--border); background: var(--surface); list-style: none; }
  .prop { display: grid; grid-template-columns: 120px auto 1fr; align-items: baseline; padding: var(--sp-3) var(--sp-4); border-bottom: 1px solid var(--border); font-size: var(--text-sm); gap: var(--sp-2); }
  .prop:last-child { border-bottom: none; }
  .prop-key { color: var(--fg-2); } .prop-sep { color: var(--fg-3); } .prop-val { color: var(--fg-3); line-height: 1.5; }
  .prop-green { color: var(--green); } .prop-str { color: #e5a86b; }

  .contact-section { background: var(--bg); border-top: 1px solid var(--border); }
  .contact-block { margin-top: var(--sp-8); border: 1px solid var(--border); background: var(--surface); overflow: hidden; }
  .contact-comment { padding: var(--sp-4) var(--sp-6); font-size: var(--text-sm); color: var(--fg-3); font-style: italic; border-bottom: 1px solid var(--border); background: var(--surface-2); }
  .contact-links { display: flex; flex-direction: column; }
  .contact-cmd { display: flex; align-items: center; gap: var(--sp-3); padding: var(--sp-4) var(--sp-6); border-bottom: 1px solid var(--border); font-size: var(--text-sm); transition: background var(--dur-fast); }
  .contact-cmd:last-child { border-bottom: none; } .contact-cmd:hover { background: var(--surface-2); } .contact-cmd:hover .cmd-arg { color: var(--green); }
  .cmd-prompt { color: var(--green); flex-shrink: 0; } .cmd-verb { color: var(--fg-2); min-width: 48px; } .cmd-arg { color: var(--fg-3); transition: color var(--dur-fast); }

  @media (max-width: 1000px) { .hero-body { grid-template-columns: 48px 1fr; } .hero-terminal { display: none; } }
  @media (max-width: 720px) { .hero-body { grid-template-columns: 1fr; padding-block: var(--sp-16); } .hero-gutter { display: none; } .hero-content { padding-left: 0; } .about-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const el = document.getElementById('typewriter') as HTMLElement | null;
  if (el) {
    const text = el.getAttribute('aria-label') ?? '';
    let i = 0;
    function type() {
      if (i < text.length) { el!.textContent += text.charAt(i++); setTimeout(type, 28 + Math.random() * 20); }
    }
    setTimeout(type, 900);
  }
</script>
