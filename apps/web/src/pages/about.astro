---
import Layout from '../layouts/Layout.astro';
import { getProfile } from '@portfolio/data';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const lang: Lang = 'es';
const t = useTranslations(lang);

const p = await getProfile(lang);
---

<Layout title={`about() — Andrés Guerrero`} description={t('meta.about.description')} lang={lang} page="about">
  <section class="section page-hero" aria-labelledby="about-page-title">
    <div class="container">
      <p class="section-tag">about.ts</p>
      <h1 class="section-heading" id="about-page-title">{t('about.title')}</h1>
    </div>
  </section>

  <section class="section about-body" aria-label="About content">
    <div class="container about-grid">
      <div class="about-text">
        <p class="about-lead">{p?.bioP1 ?? t('about.p1')}</p>
        <p class="about-p">{p?.bioP2 ?? t('about.p2')}</p>
        <p class="about-p about-p-dim">{p?.bioP3 ?? t('about.p3')}</p>
      </div>

      <aside class="about-sidebar">
        <div class="prop-block">
          <p class="prop-block-title">// config</p>
          <ul class="props">
            <li class="prop"><span class="prop-key">name</span><span class="sep">:</span><span class="prop-str">"{p?.displayName ?? t('hero.name')}"</span></li>
            <li class="prop"><span class="prop-key">role</span><span class="sep">:</span><span class="prop-str">"{p?.title ?? t('hero.title')}"</span></li>
            <li class="prop"><span class="prop-key">location</span><span class="sep">:</span><span class="prop-str">"{p?.location ?? t('about.location')}"</span></li>
            <li class="prop"><span class="prop-key">experience</span><span class="sep">:</span><span class="prop-num">"{t('about.experience')}"</span></li>
            <li class="prop"><span class="prop-key">remote</span><span class="sep">:</span><span class="prop-green">{p?.availabilityOpen ? 'true' : 'false'}</span></li>
            <li class="prop"><span class="prop-key">available</span><span class="sep">:</span><span class="prop-green">{p?.availabilityOpen ? 'true' : 'false'}</span></li>
            <li class="prop"><span class="prop-key">email</span><span class="sep">:</span><a class="prop-link" href={`mailto:${p?.email ?? 'dev.andres.guerrero@gmail.com'}`}>"{p?.email ?? 'dev.andres.guerrero@gmail.com'}"</a></li>
          </ul>
        </div>

        <div class="prop-block">
          <p class="prop-block-title">// values</p>
          <ul class="props">
            <li class="prop-text"><span class="prop-key">architecture</span><span class="sep">:</span><span class="prop-val">{t('about.card.architecture.desc')}</span></li>
            <li class="prop-text"><span class="prop-key">quality</span><span class="sep">:</span><span class="prop-val">{t('about.card.quality.desc')}</span></li>
            <li class="prop-text"><span class="prop-key">delivery</span><span class="sep">:</span><span class="prop-val">{t('about.card.delivery.desc')}</span></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
    padding-block: var(--sp-20) var(--sp-10);
  }

  .about-body { background: var(--bg); border-bottom: 1px solid var(--border); }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--sp-16);
    align-items: start;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    border-left: 2px solid var(--border);
    padding-left: var(--sp-6);
  }

  .about-lead { font-size: var(--text-lg); color: var(--fg-2); line-height: 1.85; font-weight: 300; }
  .about-p    { font-size: var(--text-base); color: var(--fg-2); line-height: 1.85; }
  .about-p-dim { color: var(--fg-3); font-style: italic; }

  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    position: sticky;
    top: calc(56px + var(--sp-8));
  }

  .prop-block {
    border: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
  }

  .prop-block-title {
    font-size: var(--text-xs);
    color: var(--fg-3);
    font-style: italic;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .props {
    list-style: none;
  }

  .prop {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
  }
  .prop:last-child { border-bottom: none; }

  .prop-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
  }
  .prop-text:last-child { border-bottom: none; }

  .prop-key   { color: var(--fg-2); flex-shrink: 0; min-width: 90px; }
  .sep        { color: var(--fg-3); flex-shrink: 0; }
  .prop-str   { color: #e5a86b; }
  .prop-num   { color: #7eb8f7; }
  .prop-green { color: var(--green); }
  .prop-val   { color: var(--fg-3); line-height: 1.6; font-size: var(--text-xs); }
  .prop-link  { color: #e5a86b; transition: color var(--dur-fast); }
  .prop-link:hover { color: var(--green); }

  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-sidebar { position: static; }
  }
</style>
